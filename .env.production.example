# ==========================================
# ROOT ENVIRONMENT FILE (Production EC2)
# Copy this to ~/scrumflow/.env on your server
# ==========================================

# This password is used by both the PostgreSQL container 
# AND the Spring Boot backend container.
DB_DATABASE=ScrumFlowProd
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_SECURE_PASSWORD_HERE

# HTTPS (Let's Encrypt). Leave empty to serve HTTP only.
# First point the domain's DNS A record at the server's Elastic IP, then set it here.
# Also switch backend.env to https:// URLs and COOKIE_SECURE=true at the same time.
TLS_DOMAIN=
# Expiry notices from Let's Encrypt (optional)
TLS_EMAIL=

# Docker Hub images to run (the CD workflow passes its own values, which win over these)
DOCKERHUB_NAMESPACE=jaouad3243
IMAGE_TAG=latest

# Browser origins allowed to call the AI service directly; empty behind nginx (same-origin)
AI_CORS_ALLOWED_ORIGINS=

# Monitoring (Grafana at /grafana/ on the gateway). The password is used when Grafana first starts.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Public address of Grafana, with the /grafana/ path (https://YOUR_DOMAIN/grafana/ once TLS_DOMAIN is set)
GRAFANA_ROOT_URL=http://YOUR_ELASTIC_IP/grafana/

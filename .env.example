# Copy to .env (next to docker-compose.yml): read by `docker compose up` for local development.
# The database credentials are defined only here, and passed both to the PostgreSQL container and to
# the backend (they take precedence over the DB_* keys of backend/.env inside Docker).
# Production uses terraform/env/root.env instead.
DB_DATABASE=growtrack_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Monitoring, started with: docker compose --profile monitoring up -d
# Grafana admin password (used when Grafana first creates its database) and its address via the gateway
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ROOT_URL=http://localhost:8080/grafana/

# Copy to backend/.env. This file is the single place where the backend's settings are defined:
# application.yml has no fallback values, so every variable below must be present (it may be empty
# where noted), or the backend refuses to start.
#
# - Running from backend/ (mvn spring-boot:run): Spring reads this file directly.
# - docker compose (development): docker-compose.override.yml loads it with env_file, and sets the
#   container-specific values itself (DB_HOST=db, STORAGE_PATH=/app/storage, DB credentials from the
#   root .env shared with the database container).
# - Production: terraform/env/backend.env, same keys.
#
# Format: KEY=value, no quotes (they would become part of the value).

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=growtrack_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# HTTP port
PORT=8000
# Internal port of /actuator/prometheus (metrics for Prometheus); never exposed by nginx
MANAGEMENT_PORT=8081

# Frontend origin, used for links in e-mails (password reset)
FRONTEND_URL=http://localhost:5173
# Origins allowed to call the API from a browser, comma separated (none are built in)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# true when the site is served over HTTPS (the refresh-token cookie is then never sent over HTTP)
COOKIE_SECURE=false

# Signs the 15-minute access JWTs (HS256, at least 32 characters: openssl rand -base64 48).
# Empty = a random key per run, so access tokens end at each restart (the frontend refreshes them).
JWT_SECRET=

# Firebase project whose Google sign-in ID tokens are accepted (projectId in frontend/src/lib/firebase.js)
FIREBASE_PROJECT_ID=scrumflow-af1fd

# Where uploaded avatars are written (served at /storage/...)
STORAGE_PATH=storage

# Mail: "log" writes e-mails to the application log, "smtp" sends them
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
# null or empty = none
MAIL_USERNAME=null
MAIL_PASSWORD=null
# smtps for implicit TLS (port 465); otherwise STARTTLS is used when the server offers it
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=ScrumFlow

# One-off seeding (php artisan db:seed equivalent): specializations, admin chef, demo data
SEED_DATABASE=false
SEED_EXIT=false
SEED_ADMIN_EMAIL=aelhail71@gmail.com
# Empty = the admin account is not created
SEED_ADMIN_PASSWORD=

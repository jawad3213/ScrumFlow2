# Settings of the API tests (loaded by ApiTestBase with @TestPropertySource, which takes precedence over
# backend/.env and environment variables). Same keys as backend/.env.example.
# The database is the PostgreSQL service of the CI workflow (.github/workflows/ci.yml); create it locally
# with: create database growtrack_testing
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=growtrack_testing
DB_USERNAME=postgres
DB_PASSWORD=12345

PORT=0
MANAGEMENT_PORT=0
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
JWT_SECRET=test-secret-for-access-tokens-0123456789
FIREBASE_PROJECT_ID=scrumflow-test
STORAGE_PATH=target/test-storage

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=ScrumFlow

SEED_DATABASE=false
SEED_EXIT=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

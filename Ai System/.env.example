# Copy to "Ai System/.env": the single place where the AI service's settings are defined.
# Every key must be present (it may be empty where noted), or the service refuses to start.
# Production: AI_CORS_ALLOWED_ORIGINS comes from root.env (docker-compose.prod.yml).

# Browser origins allowed to call the service directly, comma separated.
# Only local development without nginx needs one (Vite on :5173 calling :8001); empty = none,
# which is right behind nginx, where the frontend is same-origin.
AI_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Copy to backend.env: production Laravel config (same keys as backend/.env.example).
# DB_* values come from root.env (docker-compose.prod.yml passes them to the backend).
APP_NAME=ScrumFlow
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate_--show
APP_DEBUG=false
APP_URL=http://YOUR_ELASTIC_IP

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432

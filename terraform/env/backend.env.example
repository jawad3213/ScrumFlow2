# Copy to backend.env: production Spring Boot config (same keys as backend/.env.example).
# Every key must be present: the backend has no fallback values and refuses to start without one.
# DB_DATABASE / DB_USERNAME / DB_PASSWORD come from root.env (docker-compose.prod.yml passes them to the backend).
DB_HOST=db
DB_PORT=5432

# HTTP port inside the container (nginx and the healthcheck expect 8000)
PORT=8000
# Internal metrics port (/actuator/prometheus), scraped by Prometheus; nginx never exposes it
MANAGEMENT_PORT=8081
# Uploaded avatars: the backend_storage volume is mounted here
STORAGE_PATH=/app/storage

# Public URL of the frontend, used in password-reset e-mails.
# With HTTPS on (TLS_DOMAIN in root.env): https://YOUR_DOMAIN for both, and COOKIE_SECURE=true
FRONTEND_URL=http://YOUR_ELASTIC_IP
CORS_ALLOWED_ORIGINS=http://YOUR_ELASTIC_IP
# true once the site is served over HTTPS (the refresh-token cookie is then never sent over HTTP)
COOKIE_SECURE=false

# Signs the 15-minute access JWTs (HS256). At least 32 characters; generate one with: openssl rand -base64 48
# Keep it secret and stable: changing it ends every access token (users are then refreshed via their cookie).
JWT_SECRET=

# Firebase project whose Google sign-in ID tokens are accepted
FIREBASE_PROJECT_ID=scrumflow-af1fd

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# smtps for implicit TLS (port 465); empty = STARTTLS when offered
MAIL_SCHEME=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ScrumFlow

# One-off seeding: set SEED_DATABASE=true for one deploy to create the catalogue, admin and demo data
SEED_DATABASE=false
SEED_EXIT=false
SEED_ADMIN_EMAIL=aelhail71@gmail.com
SEED_ADMIN_PASSWORD=
